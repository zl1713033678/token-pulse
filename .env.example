# Optional runtime overrides for token-pulse MCP server (normally provided by Antigravity)
# Override bundled dashboard HTML path for fast UI development iteration
# TOKEN_PULSE_UI_HTML=D:\Code\Antigravity\token-pulse\dist\ui\dashboard.html

# Override root .gemini directory containing antigravity/ and antigravity-cli/
# ANTIGRAVITY_GEMINI_DIR=C:\Users\<username>\.gemini
